<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ExploreWorld Travel Agency</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { font-family: Arial, sans-serif; }
    .carousel-item img {
      height: 480px;
      width: 100%;
      object-fit: cover;
    }
    .carousel-caption {
      background: rgba(0, 0, 0, .6);
      border-radius: 10px;
      padding: 18px;
      bottom: 30px;
    }
    .booking-section { max-width: 850px; margin: auto; }
    @media (max-width: 576px) {
      .carousel-item img { height: 320px; }
      .carousel-caption { padding: 8px; bottom: 12px; }
      .carousel-caption h2 { font-size: 1.1rem; }
      .carousel-caption p { font-size: .85rem; margin-bottom: 0; }
    }
  </style>
</head>
<body>
  <header class="bg-primary text-white py-4">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h1 class="h3 mb-0">ExploreWorld</h1>
      <p class="mb-0">Your next adventure starts here.</p>
    </div>
  </header>

  <main>
    <section class="container py-4">
      <div class="text-center mb-4">
        <h2 class="fw-bold">Explore Amazing Destinations</h2>
        <p class="lead">Find inspiration for your next holiday.</p>
      </div>

      <!-- Bootstrap carousel: data-bs-interval sets each slide's display time -->
      <div id="destinationCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
        <div class="carousel-indicators">
          <button type="button" data-bs-target="#destinationCarousel" data-bs-slide-to="0"
                  class="active" aria-current="true" aria-label="Slide 1"></button>
          <button type="button" data-bs-target="#destinationCarousel" data-bs-slide-to="1"
                  aria-label="Slide 2"></button>
          <button type="button" data-bs-target="#destinationCarousel" data-bs-slide-to="2"
                  aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner rounded overflow-hidden">
          <div class="carousel-item active" data-bs-interval="3000">
            <img src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=1400&q=80"
                 alt="Eiffel Tower in Paris">
            <div class="carousel-caption">
              <h2>Discover Paris</h2>
              <p>Experience beautiful streets, culture, and iconic landmarks.</p>
            </div>
          </div>

          <div class="carousel-item" data-bs-interval="4000">
            <img src="https://images.unsplash.com/photo-1518548419970-58e3b4079ab2?auto=format&fit=crop&w=1400&q=80"
                 alt="Tropical island with blue ocean">
            <div class="carousel-caption">
              <h2>Relax in Bali</h2>
              <p>Enjoy tropical beaches, peaceful scenery, and island adventures.</p>
            </div>
          </div>

          <div class="carousel-item" data-bs-interval="5000">
            <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=1400&q=80"
                 alt="Dubai skyline at sunset">
            <div class="carousel-caption">
              <h2>Explore Dubai</h2>
              <p>Discover modern architecture, shopping, and desert experiences.</p>
            </div>
          </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#destinationCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#destinationCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </section>

    <section class="container booking-section py-4">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0">Booking Completion</h2>
            <span class="fw-bold">70%</span>
          </div>

          <!-- Striped and animated Bootstrap progress bar -->
          <div class="progress" role="progressbar"
               aria-label="Booking completion" aria-valuenow="70"
               aria-valuemin="0" aria-valuemax="100" style="height: 25px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="width: 70%;">70%</div>
          </div>
          <p class="text-secondary mt-2 mb-0">Your sample booking process is 70% complete.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-dark text-white py-4 mt-4">
    <div class="container text-center">
      <h2 class="h5">Contact ExploreWorld</h2>
      <p class="mb-1">Email: info@exploreworld.example</p>
      <p class="mb-1">Phone: +91 98765 43210</p>
      <p class="mb-0">&copy; 2026 ExploreWorld Travel Agency</p>
    </div>
  </footer>

  <!-- Bootstrap bundle is required for carousel controls and automatic sliding -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>